# MT5 AI交易系统环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== DeepSeek API配置 ====================
# DeepSeek API密钥 (从 https://platform.deepseek.com/api-keys 获取)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API端点 (通常不需要修改)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# DeepSeek模型 (deepseek-chat, deepseek-reasoner等)
DEEPSEEK_MODEL=deepseek-chat

# 是否启用DeepSeek AI分析 (true/false) - 设置为true时需要提供DEEPSEEK_API_KEY
USE_DEEPSEEK=false

# ==================== 性能配置 ====================
# API请求超时时间(秒)
REQUEST_TIMEOUT=30

# HTTP连接池大小
CONNECTION_POOL_SIZE=5

# API重试次数
MAX_RETRIES=3

# 响应缓存大小 (LRU缓存)
CACHE_SIZE=100

# 是否启用缓存 (true/false)
CACHE_ENABLED=true

# ==================== 精度配置 ====================
# 最小置信度阈值 (0.0-1.0)
MIN_CONFIDENCE=0.80

# 最小指标信号数 (至少需要多少个指标支持)
MIN_INDICATOR_SIGNALS=3

# 最小指标一致性 (0.0-1.0)
MIN_CONSISTENCY=0.65

# ==================== 文件监控配置 ====================
# 文件检查间隔(秒)
FILE_CHECK_INTERVAL=0.05

# 最大等待重试次数
MAX_WAIT_RETRIES=100

# ==================== 通信模式配置 ====================
# 通信模式: socket(高性能), file(兼容性), auto(自动切换)
COMMUNICATION_MODE=auto

# Socket服务器地址
SOCKET_HOST=127.0.0.1

# Socket服务器端口 (1-65535)
SOCKET_PORT=8080

# Socket连接超时时间(秒)
SOCKET_TIMEOUT=5.0

# 最大并发连接数
MAX_CONCURRENT_CONNECTIONS=10

# 重试退避因子 (指数退避)
RETRY_BACKOFF_FACTOR=2.0

# 故障转移阈值 (连续失败次数)
FAILOVER_THRESHOLD=3

# 自动切换阈值 (用于auto模式)
AUTO_SWITCH_THRESHOLD=3

# 文件模式路径 (留空使用默认路径)
FILE_MODE_PATH=

# ==================== 路径配置 ====================
# 主MT5路径 (留空使用默认)
# MT5_PRIMARY_PATH=c:\Users\Administrator\Desktop\XM Global MT5\MQL5\Files

# ==================== 动态止损止盈配置 ====================
# 基础止损点数 (当AI未提供动态值时使用)
# 默认: 30点（黄金建议40-50点）
# DYNAMIC_SL_BASE=30

# 基础止盈点数 (当AI未提供动态值时使用)
# 默认: 60点（黄金建议80-100点）
# DYNAMIC_TP_BASE=60

# 最小止损点数
# DYNAMIC_SL_MIN=15

# 最大止损点数
# DYNAMIC_SL_MAX=150

# 最小止盈点数
# DYNAMIC_TP_MIN=30

# 最大止盈点数
# DYNAMIC_TP_MAX=300